{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meliturgos",
  "main": "src/visual-final-entry.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "17 * * * *"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "meliturgos-private-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meliturgos-memory",
      "database_id": "6d502448-8780-4cf0-8c82-863cccb2e1cd"
    }
  ],
  "vars": {
    "OWNER_NAME": "Adrien",
    "MELITURGOS_USER": "adrien",
    "MEL_GITHUB_REPOSITORY": "adrienlopezcarreras-pixel/meliturgos-cloudflare",
    "MEL_GITHUB_BRANCH": "candidate/mel-clean-autonomy",
    "MEL_GITHUB_WRITABLE_WORKFLOWS": "gen2-36-provider-write-smoke.yml",
    "MEL_CLOUDFLARE_SCRIPT": "meliturgos",
    "MEL_TEACHER_BRANCH": "candidate/mel-clean-autonomy",
    "MEL_TEACHER_TRANSPORT_BRANCH": "teacher-bridge/runtime",
    "MEL_TEACHER_REPLIES_URL": "https://raw.githubusercontent.com/adrienlopezcarreras-pixel/meliturgos-cloudflare/refs/heads/teacher-bridge/runtime/teacher-bridge/replies.jsonl",
    "MEL_TEACHER_COMPLETIONS_URL": "https://raw.githubusercontent.com/adrienlopezcarreras-pixel/meliturgos-cloudflare/refs/heads/teacher-bridge/runtime/teacher-bridge/completions.jsonl",
    "MEL_LORA_CONTINUOUS_TRAINING": "true",
    "MEL_LORA_HEARTBEAT_INTERVAL_MINUTES": "15",
    "MEL_LORA_HEARTBEAT_RETRY_MINUTES": "60",
    "MEL_LORA_KAGGLE_SHARD_SIZE": "750",
    "MEL_LORA_KAGGLE_MAX_CYCLES": "1000",
    "MEL_LORA_KAGGLE_WORKFLOW": "lora-kaggle-free-gpu.yml",
    "MEL_OWNER_PERSONAL_AGENT": "true",
    "MEL_OWNER_PERSONAL_AGENT": "true",
    "MEL_SHARDVAULT_ENABLED": "false",
    "MEL_VAULT_ID": "mel-primary",
    "MEL_DATA_SHARDS": "4",
    "MEL_TOTAL_SHARDS": "7",
    "MEL_SHARDVAULT_ROADMAP_PAUSED": "true",
    "MEL_SHARDVAULT_INTERVAL_HOURS": "24",
    "MEL_SHARDVAULT_EXPORT_LIMIT": "10000",
    "MEL_WATCH_MAX_PER_OPERATOR": "2",
    "MEL_WATCH_MAX_PER_PROVIDER": "2",
    "MEL_SHARDVAULT_AUTONOMOUS": "false",
    "MEL_AUTONOMOUS_POLICY_MAX_AGE_DAYS": "180",
    "MEL_AUTONOMOUS_PROBE_LIMIT": "20",
    "MEL_AUTONOMOUS_REPOSITORIES_JSON": "[]",
    "MEL_AUTONOMOUS_FEEDS_JSON": "[]"
  },
  "env": {
    "preview": {
      "triggers": {
        "crons": []
      },
      "ai": {
        "binding": "AI"
      },
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB"
        }
      ],
      "vars": {
        "OWNER_NAME": "Adrien",
        "MELITURGOS_USER": "adrien",
        "MEL_GITHUB_REPOSITORY": "adrienlopezcarreras-pixel/meliturgos-cloudflare",
        "MEL_GITHUB_BRANCH": "candidate/mel-clean-autonomy",
        "MEL_GITHUB_WRITABLE_WORKFLOWS": "gen2-36-provider-write-smoke.yml",
        "MEL_CLOUDFLARE_SCRIPT": "meliturgos",
        "MEL_TEACHER_BRANCH": "candidate/mel-clean-autonomy",
        "MEL_TEACHER_TRANSPORT_BRANCH": "teacher-bridge/runtime",
        "MEL_TEACHER_REPLIES_URL": "https://raw.githubusercontent.com/adrienlopezcarreras-pixel/meliturgos-cloudflare/refs/heads/teacher-bridge/runtime/teacher-bridge/replies.jsonl",
        "MEL_TEACHER_COMPLETIONS_URL": "https://raw.githubusercontent.com/adrienlopezcarreras-pixel/meliturgos-cloudflare/refs/heads/teacher-bridge/runtime/teacher-bridge/completions.jsonl",
        "MEL_RUNTIME_ENV": "preview",
        "MEL_PREVIEW_ISOLATED": "true",
        "MEL_PREVIEW_AUTH_VERIFY_URL": "https://meliturgos.adrien-lopezcarreras.workers.dev/sw.js",
        "MEL_LORA_CONTINUOUS_TRAINING": "true",
        "MEL_LORA_HEARTBEAT_INTERVAL_MINUTES": "15",
        "MEL_LORA_HEARTBEAT_RETRY_MINUTES": "60",
        "MEL_LORA_KAGGLE_SHARD_SIZE": "750",
        "MEL_LORA_KAGGLE_MAX_CYCLES": "1000",
        "MEL_LORA_KAGGLE_WORKFLOW": "lora-kaggle-free-gpu.yml",
        "MEL_SHARDVAULT_ENABLED": "false",
        "MEL_VAULT_ID": "mel-primary",
        "MEL_DATA_SHARDS": "4",
        "MEL_TOTAL_SHARDS": "7",
        "MEL_SHARDVAULT_ROADMAP_PAUSED": "true",
    "MEL_SHARDVAULT_INTERVAL_HOURS": "24",
        "MEL_SHARDVAULT_EXPORT_LIMIT": "10000",
        "MEL_WATCH_MAX_PER_OPERATOR": "2",
        "MEL_WATCH_MAX_PER_PROVIDER": "2",
        "MEL_SHARDVAULT_AUTONOMOUS": "false",
        "MEL_AUTONOMOUS_POLICY_MAX_AGE_DAYS": "180",
        "MEL_AUTONOMOUS_PROBE_LIMIT": "20",
        "MEL_AUTONOMOUS_REPOSITORIES_JSON": "[]",
        "MEL_AUTONOMOUS_FEEDS_JSON": "[]"
      }
    }
  }
}
