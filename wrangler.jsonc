{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meliturgos",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "meliturgos-private-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meliturgos-memory",
      "database_id": "6d502448-8780-4cf0-8c82-863cccb2e1cd"
    }
  ],
  "vars": {
    "OWNER_NAME": "Adrien",
    "MELITURGOS_USER": "adrien",
    "MEL_GITHUB_REPOSITORY": "adrienlopezcarreras-pixel/meliturgos-cloudflare",
    "MEL_GITHUB_BRANCH": "candidate/augmentio-core",
    "MEL_TEACHER_BRANCH": "candidate/augmentio-core",
    "MEL_MENTOR_ENABLED": "true"
  }
}
