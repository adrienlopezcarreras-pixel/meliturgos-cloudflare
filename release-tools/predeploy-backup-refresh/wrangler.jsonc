{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mel-predeploy-backup-refresh",
  "main": "worker.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meliturgos-memory",
      "database_id": "6d502448-8780-4cf0-8c82-863cccb2e1cd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "meliturgos-private-media"
    }
  ]
}
